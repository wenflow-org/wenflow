{
  "name": "wenflow-backend",
  "version": "0.1.0",
  "description": "WenFlow Backend - 问流后端 API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "npm run prisma:prepare && npm run dev:server",
    "dev:server": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "node scripts/clean-dist.js && tsc -p tsconfig.build.json && node scripts/copy-system-prisma-client.js",
    "start": "node dist/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "test:ci": "jest --runInBand",
    "runtime:validate": "node scripts/validate-runtime-environment.js",
    "secrets:audit": "npm run runtime:validate && ts-node src/scripts/migrate-database-secrets.ts",
    "secrets:migrate": "npm run runtime:validate && ts-node src/scripts/migrate-database-secrets.ts --apply",
    "permissions:audit": "ts-node src/scripts/audit-sensitive-storage.ts",
    "permissions:repair": "ts-node src/scripts/audit-sensitive-storage.ts --apply",
    "database:backup:create": "node dist/operations/database-backup.cli.js create",
    "database:backup:verify": "node dist/operations/database-backup.cli.js verify",
    "prompts:sync": "npm run runtime:validate && ts-node src/scripts/ensure-core-agent-prompts.ts --sync",
    "prompts:bootstrap": "npm run runtime:validate && ts-node src/scripts/ensure-core-agent-prompts.ts --bootstrap",
    "prompts:backfill-core": "npm run runtime:validate && ts-node src/scripts/ensure-core-agent-prompts.ts --backfill",
    "prompts:sync-core": "npm run runtime:validate && ts-node src/scripts/ensure-core-agent-prompts.ts --sync",
    "prompts:lint": "ts-node src/scripts/lint-prompts.ts",
    "prompts:check-handoff": "ts-node src/scripts/check-input-handoffs.ts",
    "prompts:snapshots": "ts-node src/scripts/generate-agent-snapshots.ts",
    "prompts:snapshots:check": "ts-node src/scripts/generate-agent-snapshots.ts --check",
    "prompts:seed-routings": "ts-node src/scripts/seed-field-routings.ts",
    "prompts:drift-check": "ts-node src/scripts/field-routing-drift-probe.ts --check",
    "retired:check": "ts-node src/scripts/check-retired-skill-lists.ts",
    "prompts:skills:check": "ts-node src/scripts/check-skills-file.ts",
    "prompts:data-source:check": "ts-node src/scripts/check-data-source.ts",
    "prompts:yaml:check": "ts-node src/scripts/check-yaml-vocabulary.ts",
    "prompts:fields-sync:check": "ts-node src/scripts/check-core-fields-sync.ts --report",
    "prompts:orchestration:sync": "ts-node src/scripts/field-routing-orchestration-sync.ts",
    "prompts:check:all": "npm run prompts:lint && npm run prompts:check-handoff:strict && npm run prompts:snapshots:check && npm run prompts:drift-check && npm run retired:check && npm run prompts:skills:check && npm run prompts:data-source:check && npm run prompts:yaml:check && npm run prompts:fields-sync:check",
    "prompts:check-handoff:strict": "ts-node src/scripts/check-input-handoffs.ts --strict",
    "prompts:core:check": "npm run runtime:validate && ts-node src/scripts/check-core-hash-parity.ts",
    "prompts:runtime-contract:check": "npm run runtime:validate && ts-node src/scripts/check-prompt-runtime-contract-metadata-parity.ts",
    "llm:calls:check": "ts-node src/scripts/check-llm-call-boundary.ts",
    "prompts:compile-all": "ts-node src/scripts/compile-core-files.ts",
    "verify:kv-prefix-cache": "ts-node src/scripts/verify-kv-prefix-cache.ts",
    "prisma:generate": "npm run prisma:generate:all",
    "prisma:generate:main": "prisma generate",
    "prisma:generate:system": "prisma generate --schema prisma/system/schema.prisma",
    "prisma:generate:all": "npm run prisma:generate:main && npm run prisma:generate:system",
    "prisma:prepare": "npm run prisma:generate:all && npm run prisma:migrate:deploy:all",
    "prisma:migrate:deploy:main": "prisma migrate deploy --schema prisma/schema.prisma",
    "prisma:migrate:deploy:system": "prisma migrate deploy --schema prisma/system/schema.prisma",
    "prisma:migrate:deploy:all": "npm run runtime:validate && npm run prisma:migrate:deploy:main && npm run prisma:migrate:deploy:system",
    "prisma:migrate:status:main": "prisma migrate status --schema prisma/schema.prisma",
    "prisma:migrate:status:system": "prisma migrate status --schema prisma/system/schema.prisma",
    "prisma:migrate:verify-clean": "ts-node src/scripts/verify-prisma-clean-replay.ts",
    "prisma:baseline:audit": "ts-node src/scripts/adopt-prisma-baseline.ts",
    "prisma:baseline:adopt": "ts-node src/scripts/adopt-prisma-baseline.ts --apply",
    "prisma:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "prisma:studio": "prisma studio",
    "prisma:validate": "prisma validate --schema prisma/schema.prisma && prisma validate --schema prisma/system/schema.prisma"
  },
  "keywords": [
    "ai",
    "learning",
    "education",
    "api"
  ],
  "author": "老哥",
  "license": "MIT",
  "engines": {
    "node": ">=20.17.0"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "axios": "^1.6.5",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.3.2",
    "helmet": "^7.1.0",
    "js-yaml": "^4.1.1",
    "jsonwebtoken": "^9.0.2",
    "openai": "^4.26.0",
    "prisma": "^5.22.0",
    "sqlite3": "^6.0.1",
    "winston": "^3.11.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/bcrypt": "^5.0.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/js-yaml": "^4.0.9",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.11.5",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  },
  "overrides": {
    "uuid": "10.0.0"
  }
}
