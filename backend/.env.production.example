# ===========================================
# WenFlow 后端配置 - 服务器部署示例
# ===========================================
# 复制此文件为 .env 并根据实际情况修改

# 服务器配置
NODE_ENV=production
PORT=3001
LOG_DIR=logs

# CORS 配置 (多个来源用逗号分隔)
# 【必须修改】改成你的实际域名或IP
CORS_ORIGIN=https://your-domain.com,http://your-ip:5173

# 反向代理配置：填写直接连接后端的受信代理 IP/CIDR，不要使用 true。
# Docker Compose 已覆盖为固定 Nginx 容器 IP；裸机 Nginx 常用 127.0.0.1。
TRUST_PROXY=127.0.0.1
SHUTDOWN_DEADLINE_MS=25000

# Admin 默认只允许服务器本机和局域网客户端访问；公网管理需使用 VPN 或精确 ADMIN_ALLOWED_IPS
ADMIN_ACCESS_MODE=private
ADMIN_ALLOWED_IPS=

# 数据库配置
# 【推荐】继续使用 SQLite (简单可靠)
DATABASE_URL=file:./dev.db
SYSTEM_DATABASE_URL=file:../system.db
# 必须是仓库外的绝对路径；容器部署需挂载独立外部目录。
WENFLOW_BACKUP_DIR=
# 【可选】PostgreSQL (如需更高性能)
# DATABASE_URL="postgresql://wenflow:password@localhost:5432/wenflow"

# JWT 配置 (生产环境建议使用强密钥)
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# 数据库 API Key/MCP 凭据加密（生产环境必填）。轮换时保留旧 Key，并切换 CURRENT_KEY_ID。
SECRET_ENCRYPTION_CURRENT_KEY_ID=v1
SECRET_ENCRYPTION_KEYS=v1:

# 登录保护配置
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_DURATION_SECONDS=900

# AI 服务配置
# 【必须修改】填写你的 AI API 配置
AI_API_URL=https://api.deepseek.com
AI_API_KEY=sk-your-api-key
AI_MODEL=deepseek-v4-flash
AI_MODEL_REASONING=deepseek-v4-pro
# 私有模型服务精确 Allowlist，例如 192.168.31.26,ollama.internal
SAFE_HTTP_PRIVATE_HOSTS=
# 生产环境建议保持 false，并通过 SAFE_HTTP_PRIVATE_HOSTS 或 Admin 页面精确放行。
SAFE_HTTP_ALLOW_PRIVATE_NETWORK=false
# 如网络使用 RFC 6052 自定义 NAT64 前缀，必须登记 CIDR，逗号分隔。
SAFE_HTTP_NAT64_PREFIXES=

# 前端 URL
# 【必须修改】改成你的实际访问地址
FRONTEND_URL=https://your-domain.com

# 初始管理员
INIT_ADMIN_NAME=admin
INIT_ADMIN_EMAIL=admin@your-domain.com
INIT_ADMIN_PASSWORD=
