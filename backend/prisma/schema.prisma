generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}



model achievements {
  id          String    @id
  userId      String
  type        String?
  title       String
  description String?
  iconUrl     String?
  current     Int?
  target      Int?
  completed   Boolean   @default(false)
  xpReward    Int       @default(0)
  createdAt   DateTime  @default(now())
  unlockedAt  DateTime?
  earnedAt    DateTime?
  users       users     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model agent_call_logs {
  id                String   @id
  agentId           String
  userId            String
  sourceEntry       String   @default("platform")
  traceId           String?
  callerAgent       String?
  userRole          String   @default("user")
  input             String?
  output            String?
  success           Boolean  @default(false)
  durationMs        Int      @default(0)
  tokensUsed        Int?
  error             String?
  errorCode         String?
  calledAt          DateTime @default(now())
  metadata          String?
  executionLayer    String?
  actorType         String?
  actorId           String?
  parentExecutionId String?
  rootExecutionId   String?
  promptCallId      String?
  providerId        String?
  providerType      String?
  routeSource       String?
  model             String?
  statusCode        Int?
  attemptCount      Int?
  maxAttempts       Int?
  promptTokens      Int?
  completionTokens  Int?
  finishReason      String?
  completionId      String?
  errorCategory     String?

  @@index([agentId, calledAt])
  @@index([calledAt])
  @@index([success])
  @@index([traceId])
  @@index([sourceEntry])
  @@index([userId])
  @@index([agentId])
  @@index([parentExecutionId, calledAt])
  @@index([promptCallId, calledAt])
  @@index([executionLayer, calledAt])
  @@index([providerId, calledAt])
}




model prompt_call_logs {
  id                  String   @id
  agentId             String
  systemPromptVersion Int?
  systemPromptHash    String
  userPayload         String
  rawModelOutput      String?
  extractedJson       String?
  normalizedOutput    String?
  success             Boolean  @default(false)
  errorCode           String?
  errorMessage        String?
  promptDrift         Boolean  @default(false)
  durationMs          Int      @default(0)
  tokenUsage          String?
  routingContextHash  String?
  pathId              String?
  userId              String?
  conversationId      String?
  pipelineRunId       String?
  pipelineStepIndex   Int?
  traceId             String?
  parentExecutionId   String?
  promptAttemptCount  Int      @default(1)
  llmRequestCount     Int      @default(0)
  finalLlmRequestId   String?
  failureStage        String?
  attemptTrace        String?
  providerId          String?
  model               String?
  createdAt           DateTime @default(now())

  @@index([agentId, createdAt])
  @@index([pipelineRunId])
  @@index([pathId])
  @@index([userId])
  @@index([traceId])
  @@index([parentExecutionId])
  @@index([finalLlmRequestId])
}

model llm_execution_attempts {
  id                  String   @id
  llmRequestId        String
  parentExecutionId   String?
  promptCallId        String?
  rootExecutionId     String?
  traceId             String?
  userId              String?
  sourceEntry         String   @default("platform")
  promptAttemptNo     Int      @default(1)
  transportAttemptNo  Int
  maxAttempts         Int
  providerId          String?
  providerType        String?
  routeSource         String?
  requestedModel      String?
  resolvedModel       String?
  responseModel       String?
  endpointHost        String?
  success             Boolean  @default(false)
  retryable           Boolean?
  willRetry           Boolean  @default(false)
  statusCode          Int?
  errorCategory       String?
  errorCode           String?
  errorMessage        String?
  startedAt           DateTime
  completedAt         DateTime
  durationMs          Int
  backoffMs           Int?
  retryAfterMs        Int?
  configuredTimeoutMs Int?
  effectiveTimeoutMs  Int?
  promptTokens        Int?
  completionTokens    Int?
  totalTokens         Int?
  finishReason        String?
  completionId        String?
  providerRequestId   String?
  messageCount        Int?
  requestBytes        Int?
  responseBytes       Int?
  expiresAt           DateTime
  metadata            String?
  createdAt           DateTime @default(now())

  @@unique([llmRequestId, transportAttemptNo])
  @@index([startedAt, id])
  @@index([traceId, startedAt])
  @@index([parentExecutionId, startedAt])
  @@index([promptCallId, promptAttemptNo, transportAttemptNo])
  @@index([providerId, resolvedModel, startedAt])
  @@index([rootExecutionId, startedAt])
  @@index([userId, startedAt])
  @@index([errorCategory, startedAt])
}









model content_feedback {
  id              String    @id
  feedbackKey     String?   @unique
  userId          String
  sessionId       String
  subtaskId       String?
  agentId         String    @default("teaching-agent")
  rating          Int
  helpfulness     Int?
  clarity         Int?
  difficulty      Int?
  difficultyFit   String?
  comment         String?
  suggestions     String?
  confusionPoint  String?
  reasonCodes     String?
  strategy        String?
  uiType          String?
  roundNumber     Int?
  status          String    @default("new")
  assigneeAdminId String?
  internalNote    String?
  resolvedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  users           users     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionId])
  @@index([agentId])
  @@index([status, createdAt])
  @@index([rating, createdAt])
}






model goal_conversations {
  id             String    @id
  userId         String
  status         String    @default("active")
  stage          String    @default("initial")
  description    String?
  messages       String
  collectedData  String?
  completedAt    DateTime?
  learningPathId String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now())
  users          users     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model learning_goals {
  id          String   @id
  userId      String
  title       String
  description String?
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())
  users       users    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model learning_metrics {
  id           String   @id
  sourceKey    String?  @unique
  userId       String
  pathId       String?
  taskId       String?
  metricType   String
  value        Float
  lss          Float?   @default(0)
  ktl          Float?   @default(0)
  lf           Float?   @default(0)
  lsb          Float?   @default(0)
  depth_score  Float?   @default(0)
  metadata     String?
  recordedAt   DateTime @default(now())
  calculatedAt DateTime @default(now())
  ktlCurrent   Float?   @default(0)
  lfCurrent    Float?   @default(0)
  lsbCurrent   Float?   @default(0)
  lssCurrent   Float?   @default(0)
  lssHistory   String?
  dki          Float?   @default(0)
  mki          Float?   @default(0)
  ski          Float?   @default(0)
  users        users    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model learning_paths {
  id                    String                  @id
  userId                String
  title                 String
  name                  String?
  description           String?
  subject               String?
  status                String                  @default("active")
  difficulty            String                  @default("beginner")
  estimatedHours        Float?
  totalMilestones       Int                     @default(0)
  completedMilestones   Int                     @default(0)
  aiGenerated           Boolean                 @default(false)
  aiPromptTemplate      String?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime
  deadline              DateTime?
  deadlineText          String?
  replanMode            String?
  replanReason          String?
  replanTriggerSource   String?
  sourcePathId          String?
  activeGenerationRunId String?                 @unique
  users                 users                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  milestones            milestones[]
  generationRuns        path_generation_runs[]  @relation("PathGenerationRuns")
  activeGenerationRun   path_generation_runs?   @relation("ActivePathGenerationRun", fields: [activeGenerationRunId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
}

model path_generation_runs {
  id                 String                        @id
  learningPathId     String
  phase              String
  status             String                        @default("queued")
  retryType          String?
  retryAllowed       Boolean                       @default(false)
  attempt            Int                           @default(1)
  totalItems         Int                           @default(0)
  completedItems     Int                           @default(0)
  progress           Int                           @default(0)
  inputSnapshot      String?
  rollbackSnapshot   String?
  heartbeatAt        DateTime?
  leaseExpiresAt     DateTime?
  leaseOwner         String?
  claimedAt          DateTime?
  startedAt          DateTime?
  finishedAt         DateTime?
  errorCode          String?
  errorMessage       String?
  createdAt          DateTime                      @default(now())
  updatedAt          DateTime                      @updatedAt
  learningPath       learning_paths                @relation("PathGenerationRuns", fields: [learningPathId], references: [id], onDelete: Cascade)
  activeForPath      learning_paths?               @relation("ActivePathGenerationRun")
  stageItems         path_generation_stage_items[]

  @@index([learningPathId, createdAt])
  @@index([status, leaseExpiresAt])
  @@index([phase, status])
}

model path_generation_stage_items {
  id             String               @id
  runId          String
  milestoneId    String?
  stageNumber    Int
  status         String               @default("queued")
  taskCount      Int                  @default(0)
  heartbeatAt    DateTime?
  startedAt      DateTime?
  finishedAt     DateTime?
  errorCode      String?
  errorMessage   String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  run            path_generation_runs @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, stageNumber])
  @@index([runId, status])
}

model milestones {
  id              String         @id
  learningPathId  String
  stageNumber     Int
  title           String
  description     String?
  goal            String?
  estimatedHours  Float?
  status          String         @default("locked")
  unlockedAt      DateTime?
  startedAt       DateTime?
  completedAt     DateTime?
  order           Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime
  coreConceptId   String?
  coreConceptName String?
  learning_paths  learning_paths @relation(fields: [learningPathId], references: [id], onDelete: Cascade)
  subtasks        subtasks[]

  @@unique([learningPathId, stageNumber])
  @@index([learningPathId])
  @@index([status])
}


model student_baselines {
  id                       String    @id
  userId                   String    @unique
  totalXp                  Int       @default(0)
  totalTime                Int       @default(0)
  totalTasks               Int       @default(0)
  completedTasks           Int       @default(0)
  avgRating                Float     @default(0)
  streakDays               Int       @default(0)
  lastActive               DateTime?
  responseTimeEma          Float     @default(10.0)
  responseTimeEmVar        Float     @default(1.0)
  messageLengthEma         Float     @default(50.0)
  messageLengthEmVar       Float     @default(100.0)
  interactionIntervalEma   Float     @default(5.0)
  interactionIntervalEmVar Float     @default(1.0)
  aiScoreEma               Float     @default(0.5)
  aiScoreEmVar             Float     @default(0.01)
  updateCount              Int       @default(0)
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @default(now())
  users                    users     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model subtasks {
  id                   String             @id
  milestoneId          String
  userId               String
  title                String
  description          String?
  taskType             String             @default("practice")
  estimatedMinutes     Int                @default(30)
  acceptanceCriteria   String?
  order                Int                @default(0)
  status               String             @default("todo")
  completedAt          DateTime?
  rating               Int?
  feedback             String?
  cognitiveLoad        String             @default("medium")
  createdAt            DateTime           @default(now())
  updatedAt            DateTime
  usersId              String?
  annotationConfidence Float?
  cognitiveLevel       String?
  coreConcept          String?
  displayLabel         String?
  knowledgeType        String?
  learningObjectives   String?
  transferable         Boolean?           @default(false)
  linkedConceptId      String?
  linkedConceptName    String?
  users                users?             @relation(fields: [usersId], references: [id])
  milestones           milestones         @relation(fields: [milestoneId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([userId])
  @@index([milestoneId])
  @@index([knowledgeType])
  @@index([cognitiveLevel])
}


model teaching_sessions {
  id                      String    @id
  userId                  String
  taskId                  String
  learningPathId          String?
  milestoneId             String?
  subject                 String
  topic                   String
  taskType                String    @default("practice")
  mode                    String    @default("tutor")
  status                  String    @default("active")
  messages                String?
  knowledgeState          String?
  teachingState           String?
  wrapup                  String?
  advisory                String?
  startTime               DateTime  @default(now())
  endTime                 DateTime?
  duration                Int?
  revision                Int       @default(0)
  openKey                 String?   @unique
  operationId             String?
  operationKind           String?
  operationLeaseExpiresAt DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @default(now())
  users                   users     @relation(fields: [userId], references: [id], onDelete: Cascade)
  finalizationOperations  session_finalization_operations[]

  @@index([userId, taskId, status])
  @@index([status, updatedAt])
  @@index([operationLeaseExpiresAt])
  @@index([status])
  @@index([taskId])
  @@index([userId])
}

model session_finalization_operations {
  id              String   @id @default(uuid())
  sessionId       String
  idempotencyKey  String
  action          String
  requestHash     String
  requestJson     String
  status          String   @default("processing")
  leaseOwner      String?
  leaseExpiresAt  DateTime?
  attemptCount    Int      @default(1)
  resultJson      String?
  errorCode       String?
  retryable       Boolean?
  startedAt       DateTime @default(now())
  completedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  session         teaching_sessions @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, idempotencyKey])
  @@index([status, leaseExpiresAt])
  @@index([sessionId, action, createdAt])
}

model domain_event_outbox {
  id               String   @id
  eventType        String
  schemaVersion    Int      @default(1)
  aggregateType    String
  aggregateId      String
  aggregateVersion Int?
  userId           String?
  source           String
  payload          String
  metadata         String?
  status           String   @default("pending")
  attemptCount     Int      @default(0)
  availableAt      DateTime @default(now())
  lockedAt         DateTime?
  lockOwner        String?
  processedAt      DateTime?
  lastError        String?
  occurredAt       DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([status, availableAt])
  @@index([status, lockedAt])
  @@index([aggregateType, aggregateId, occurredAt])
  @@index([userId, occurredAt])
}

model domain_event_inbox {
  id         String   @id
  consumerId String
  eventId    String
  processedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@unique([consumerId, eventId])
  @@index([eventId])
}

model learner_evidence {
  id           String   @id
  eventId      String
  evidenceKey  String
  userId       String
  pathId       String?
  milestoneId  String?
  taskId       String?
  sessionId    String?
  evidenceType String
  payload      String
  confidence   Float    @default(1)
  occurredAt   DateTime
  createdAt    DateTime @default(now())

  @@unique([eventId, evidenceKey])
  @@index([userId, occurredAt])
  @@index([pathId, occurredAt])
  @@index([sessionId])
  @@index([taskId])
}

model learner_projections {
  id             String   @id
  projectionKey  String   @unique
  userId         String
  scope          String
  pathId         String?
  milestoneId    String?
  taskId         String?
  version        Int      @default(1)
  payload        String
  lastEventId    String?
  lastEventAt    DateTime?
  generatedAt    DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId, scope])
  @@index([userId, pathId, scope])
  @@index([lastEventAt])
}

/// 知识点记忆痕迹（记忆引擎 M2）：ACT-R 幂律衰减的持久化载体。
/// 每个（用户 × 概念）一行；masteryScore 为最近一次评估的内化强度，
/// lastSeenAt 为最近一次提取/复习时间，decayFactor 为幂律衰减参数 d（默认 0.5，预留个性化标定）。
model memory_traces {
  id              String    @id
  userId          String
  conceptKey      String
  label           String?
  masteryScore    Float     @default(0.5)
  stability       String    @default("developing") // unknown | fragile | developing | stable
  lastSeenAt      DateTime?
  extractionCount Int       @default(0)
  decayFactor     Float     @default(0.5)
  lastRetention   Float?
  source          String?   // derived（从 knowledgeState 确定性映射）| model（LLM 评估，预留）
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([userId, conceptKey])
  @@index([userId, lastSeenAt])
  @@index([userId, stability])
}

model user_agent_configs {
  id               String   @id
  userId           String
  agentName        String
  enabled          Boolean  @default(true)
  sourceType       String
  codeRepositoryId String?
  model            String?
  temperature      Float?
  maxTokens        Int?
  systemPrompt     String?
  customCode       String?
  version          String   @default("1.0.0")
  stats            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime
  users            users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, agentName])
}

model user_agent_model_configs {
  id          String   @id
  userId      String
  agentId     String
  model       String?
  endpoint    String?
  apiKey      String?
  temperature Float?
  maxTokens   Int?
  enabled     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime
  users       users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, agentId])
}

model user_api_configs {
  id             String   @id
  userId         String   @unique
  endpoint       String?
  apiKey         String?
  chatModel      String?
  reasoningModel String?
  enabled        Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now())
  users          users    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model user_mcp_configs {
  id              String   @id
  userId          String   @unique
  servers         String
  tools           String
  routingStrategy String   @default("priority")
  fallbackEnabled Boolean  @default(true)
  healthCheck     String
  createdAt       DateTime @default(now())
  updatedAt       DateTime
  users           users    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model user_skill_configs {
  id               String   @id
  userId           String
  skillName        String
  enabled          Boolean  @default(true)
  sourceType       String
  codeRepositoryId String?
  parameters       String?
  customCode       String?
  endpoint         String?
  stats            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime
  users            users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, skillName])
}

model projection_access_grants {
  id                String   @id @default(uuid())
  userId            String
  scope             String   @default("dashboard")
  scopeDefinition   String?
  purpose           String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  expiresAt         DateTime
  revokedAt         DateTime?
  lastUsedAt        DateTime?
  lastUsedByAdminId String?
  useCount          Int      @default(0)
  users             users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
}

model users {
  id                        String                     @id
  email                     String                     @unique
  name                      String
  password                  String
  role                      String                     @default("user")
  currentLevel              String                     @default("beginner")
  xp                        Int                        @default(0)
  isAdmin                   Boolean                    @default(false)
  isVirtualLearner          Boolean                    @default(false)
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime
  lastLoginAt               DateTime?
  dashboardGuidanceSnapshot String?
  learningStateRevision     Int                        @default(0)
  achievements              achievements[]
  content_feedback          content_feedback[]
  goal_conversations        goal_conversations[]
  learning_goals            learning_goals[]
  learning_metrics          learning_metrics[]
  learning_paths            learning_paths[]
  projection_access_grants  projection_access_grants[]
  student_baselines         student_baselines?
  subtasks                  subtasks[]
  teaching_sessions         teaching_sessions[]
  user_agent_configs        user_agent_configs[]
  user_agent_model_configs  user_agent_model_configs[]
  user_api_configs          user_api_configs?
  user_mcp_configs          user_mcp_configs?
  user_skill_configs        user_skill_configs[]
  virtual_learner_profiles  virtual_learner_profiles?
  virtual_sessions          virtual_sessions[]
}

model virtual_learner_profiles {
  id                    String             @id @default(uuid())
  userId                String             @unique
  profile               String
  learningGoal          String
  knowledgeLevel        String
  knownConcepts         String?
  struggleConcepts      String?
  simulationMode        String             @default("manual")
  simulationPrompt      String?
  simulationModel       String?
  simulationTemperature Float?             @default(0.8)
  personalityTraits     String?
  tags                  String?
  notes                 String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  users                 users              @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions              virtual_sessions[]

  @@index([userId])
}

model virtual_sessions {
  id                       String                   @id @default(uuid())
  virtualProfileId         String
  userId                   String
  status                   String                   @default("created")
  currentStage             String                   @default("goal")
  goalConversationId       String?
  learningPathId           String?
  currentTaskId            String?
  completedTasks           Int                      @default(0)
  totalTasks               Int                      @default(0)
  stageResults             String?
  logs                     String?
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt
  completedAt              DateTime?
  users                    users                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  virtual_learner_profiles virtual_learner_profiles @relation(fields: [virtualProfileId], references: [id], onDelete: Cascade)
  experimentLease          virtual_experiment_leases?
  experimentCommands       virtual_experiment_commands[]

  @@index([virtualProfileId])
  @@index([userId])
  @@index([status])
}

model virtual_experiment_leases {
  sessionId String   @id
  ownerId   String
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  session   virtual_sessions @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model virtual_experiment_commands {
  id          String   @id @default(uuid())
  sessionId   String
  experimentId String
  runId       String
  commandId   String
  sequence    Int
  kind        String
  requestJson String
  status      String   @default("processing")
  resultJson  String?
  errorJson   String?
  triggeredBy String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  completedAt DateTime?
  session     virtual_sessions @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([runId, commandId])
  @@unique([runId, sequence])
  @@index([sessionId, createdAt])
  @@index([runId, status])
}

model virtual_quick_learn_runs {
  id                String    @id @default(uuid())
  profileId         String
  userId            String
  pathId            String
  taskId            String
  fixtureOfPathId   String?
  mode              String    @default("fast_forward")
  status            String    @default("queued")
  maxTurns          Int       @default(25)
  turns             Int       @default(0)
  teachingSessionId String?
  progress          String?
  transcript        String?
  report            String?
  error             String?
  abortRequestedAt  DateTime?
  startedAt         DateTime?
  completedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([profileId, createdAt])
  @@index([status])
  @@index([userId])
}

model announcements {
  id          String    @id @default(uuid())
  title       String
  body        String
  severity    String    @default("info")
  status      String    @default("draft")
  publishedAt DateTime?
  expiresAt   DateTime?
  createdBy   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, publishedAt])
}
