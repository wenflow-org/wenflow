generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}



model achievements {
  id          String    @id
  userId      String
  type        String?
  title       String
  description String?
  iconUrl     String?
  current     Int?
  target      Int?
  completed   Boolean   @default(false)
  xpReward    Int       @default(0)
  createdAt   DateTime  @default(now())
  unlockedAt  DateTime?
  earnedAt    DateTime?
  users       users     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type, completed])
}

model agent_call_logs {
  id                String   @id
  agentId           String
  userId            String
  sourceEntry       String   @default("platform")
  traceId           String?
  callerAgent       String?
  userRole          String   @default("user")
  input             String?
  output            String?
  success           Boolean  @default(false)
  durationMs        Int      @default(0)
  tokensUsed        Int?
  error             String?
  errorCode         String?
  calledAt          DateTime @default(now())
  metadata          String?
  executionLayer    String?
  actorType         String?
  actorId           String?
  parentExecutionId String?
  rootExecutionId   String?
  promptCallId      String?
  providerId        String?
  providerType      String?
  routeSource       String?
  model             String?
  statusCode        Int?
  attemptCount      Int?
  maxAttempts       Int?
  promptTokens      Int?
  completionTokens  Int?
  finishReason      String?
  completionId      String?
  errorCategory     String?

  @@index([agentId, calledAt])
  @@index([calledAt])
  @@index([success])
  @@index([traceId])
  @@index([sourceEntry])
  @@index([userId])
  @@index([agentId])
  @@index([parentExecutionId, calledAt])
  @@index([promptCallId, calledAt])
  @@index([executionLayer, calledAt])
  @@index([providerId, calledAt])
}




model prompt_call_logs {
  id                  String   @id
  agentId             String
  systemPromptVersion Int?
  systemPromptHash    String
  userPayload         String
  rawModelOutput      String?
  extractedJson       String?
  normalizedOutput    String?
  success             Boolean  @default(false)
  errorCode           String?
  errorMessage        String?
  promptDrift         Boolean  @default(false)
  durationMs          Int      @default(0)
  tokenUsage          String?
  routingContextHash  String?
  pathId              String?
  userId              String?
  conversationId      String?
  pipelineRunId       String?
  pipelineStepIndex   Int?
  traceId             String?
  parentExecutionId   String?
  promptAttemptCount  Int      @default(1)
  llmRequestCount     Int      @default(0)
  finalLlmRequestId   String?
  failureStage        String?
  attemptTrace        String?
  providerId          String?
  model               String?
  createdAt           DateTime @default(now())

  @@index([agentId, createdAt])
  @@index([pipelineRunId])
  @@index([pathId])
  @@index([userId])
  @@index([traceId])
  @@index([parentExecutionId])
  @@index([finalLlmRequestId])
}

model llm_execution_attempts {
  id                  String   @id
  llmRequestId        String
  parentExecutionId   String?
  promptCallId        String?
  rootExecutionId     String?
  traceId             String?
  userId              String?
  sourceEntry         String   @default("platform")
  promptAttemptNo     Int      @default(1)
  transportAttemptNo  Int
  maxAttempts         Int
  providerId          String?
  providerType        String?
  routeSource         String?
  requestedModel      String?
  resolvedModel       String?
  responseModel       String?
  endpointHost        String?
  success             Boolean  @default(false)
  retryable           Boolean?
  willRetry           Boolean  @default(false)
  statusCode          Int?
  errorCategory       String?
  errorCode           String?
  errorMessage        String?
  startedAt           DateTime
  completedAt         DateTime
  durationMs          Int
  backoffMs           Int?
  retryAfterMs        Int?
  configuredTimeoutMs Int?
  effectiveTimeoutMs  Int?
  promptTokens        Int?
  completionTokens    Int?
  totalTokens         Int?
  finishReason        String?
  completionId        String?
  providerRequestId   String?
  messageCount        Int?
  requestBytes        Int?
  responseBytes       Int?
  // KV 前缀缓存可观测（2026-08）：TTFT（流式首 delta）与 DeepSeek 自动前缀缓存命中
  ttftMs               Int?
  promptCacheHitTokens Int?
  promptCacheMissTokens Int?
  expiresAt           DateTime
  metadata            String?
  createdAt           DateTime @default(now())

  @@unique([llmRequestId, transportAttemptNo])
  @@index([startedAt, id])
  @@index([traceId, startedAt])
  @@index([parentExecutionId, startedAt])
  @@index([promptCallId, promptAttemptNo, transportAttemptNo])
  @@index([providerId, resolvedModel, startedAt])
  @@index([rootExecutionId, startedAt])
  @@index([userId, startedAt])
  @@index([errorCategory, startedAt])
  @@index([success, errorCategory, startedAt])
  @@index([userId, startedAt, success])
}









model content_feedback {
  id              String    @id
  feedbackKey     String?   @unique
  userId          String
  sessionId       String
  subtaskId       String?
  agentId         String    @default("teaching-agent")
  rating          Int
  helpfulness     Int?
  clarity         Int?
  difficulty      Int?
  difficultyFit   String?
  comment         String?
  suggestions     String?
  confusionPoint  String?
  reasonCodes     String?
  strategy        String?
  uiType          String?
  roundNumber     Int?
  status          String    @default("new")
  assigneeAdminId String?
  internalNote    String?
  resolvedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  users           users     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionId])
  @@index([agentId])
  @@index([status, createdAt])
  @@index([rating, createdAt])
}






model goal_conversations {
  id             String    @id
  userId         String
  status         String    @default("active")
  stage          String    @default("initial")
  description    String?
  messages       String
  collectedData  String?
  completedAt    DateTime?
  learningPathId String?
  // 乐观锁：messages/collectedData 为整包 JSON 读改写，并发提交（双击/重试）时
  // 以 revision 条件更新防止互相覆盖丢消息
  revision       Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now())
  users          users     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([status, updatedAt])
  @@index([learningPathId])
}

model learning_goals {
  id                    String   @id
  userId                String
  title                 String
  description           String?
  status                String   @default("active")
  // 多目标预算台账（阶段 8）：目标级调度元数据
  pathId                String?
  priority              Int      @default(0)
  plannedMinutesPerDay  Int?
  cognitiveBandwidth    String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @default(now())
  users                 users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

model goal_scheduling_ledger {
  id                String   @id
  userId            String
  goalId            String?
  date              String
  budgetMinutes     Int      @default(30)
  consumedMinutes   Float    @default(0)
  plannedTasks      String?
  loadAvg           Float?
  status            String   @default("scheduled")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now())

  @@unique([userId, goalId, date])
  @@index([userId, date])
}

model learning_metrics {
  id           String   @id
  sourceKey    String?  @unique
  userId       String
  pathId       String?
  taskId       String?
  metricType   String
  value        Float
  lss          Float?   @default(0)
  ktl          Float?   @default(0)
  lf           Float?   @default(0)
  lsb          Float?   @default(0)
  depth_score  Float?   @default(0)
  metadata     String?
  recordedAt   DateTime @default(now())
  calculatedAt DateTime @default(now())
  ktlCurrent   Float?   @default(0)
  lfCurrent    Float?   @default(0)
  lsbCurrent   Float?   @default(0)
  lssCurrent   Float?   @default(0)
  lssHistory   String?
  dki          Float?   @default(0)
  mki          Float?   @default(0)
  ski          Float?   @default(0)
  users        users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, calculatedAt])
}

model learning_paths {
  id                    String                  @id
  userId                String
  title                 String
  name                  String?
  description           String?
  subject               String?
  status                String                  @default("active")
  difficulty            String                  @default("beginner")
  estimatedHours        Float?
  totalMilestones       Int                     @default(0)
  completedMilestones   Int                     @default(0)
  aiGenerated           Boolean                 @default(false)
  aiPromptTemplate      String?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime
  deadline              DateTime?
  deadlineText          String?
  replanMode            String?
  replanReason          String?
  replanTriggerSource   String?
  sourcePathId          String?
  activeGenerationRunId String?                 @unique
  users                 users                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  milestones            milestones[]
  generationRuns        path_generation_runs[]  @relation("PathGenerationRuns")
  activeGenerationRun   path_generation_runs?   @relation("ActivePathGenerationRun", fields: [activeGenerationRunId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@index([userId, status])
}

model path_generation_runs {
  id                 String                        @id
  learningPathId     String
  phase              String
  status             String                        @default("queued")
  retryType          String?
  retryAllowed       Boolean                       @default(false)
  attempt            Int                           @default(1)
  totalItems         Int                           @default(0)
  completedItems     Int                           @default(0)
  progress           Int                           @default(0)
  inputSnapshot      String?
  rollbackSnapshot   String?
  heartbeatAt        DateTime?
  leaseExpiresAt     DateTime?
  leaseOwner         String?
  claimedAt          DateTime?
  startedAt          DateTime?
  finishedAt         DateTime?
  errorCode          String?
  errorMessage       String?
  createdAt          DateTime                      @default(now())
  updatedAt          DateTime                      @updatedAt
  learningPath       learning_paths                @relation("PathGenerationRuns", fields: [learningPathId], references: [id], onDelete: Cascade)
  activeForPath      learning_paths?               @relation("ActivePathGenerationRun")
  stageItems         path_generation_stage_items[]

  @@index([learningPathId, createdAt])
  @@index([status, leaseExpiresAt])
  @@index([phase, status])
}

model path_generation_stage_items {
  id             String               @id
  runId          String
  milestoneId    String?
  stageNumber    Int
  status         String               @default("queued")
  taskCount      Int                  @default(0)
  heartbeatAt    DateTime?
  startedAt      DateTime?
  finishedAt     DateTime?
  errorCode      String?
  errorMessage   String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  run            path_generation_runs @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, stageNumber])
  @@index([runId, status])
}

model milestones {
  id              String         @id
  learningPathId  String
  stageNumber     Int
  title           String
  description     String?
  goal            String?
  estimatedHours  Float?
  status          String         @default("locked")
  unlockedAt      DateTime?
  startedAt       DateTime?
  completedAt     DateTime?
  order           Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime
  coreConceptId   String?
  coreConceptName String?
  learning_paths  learning_paths @relation(fields: [learningPathId], references: [id], onDelete: Cascade)
  subtasks        subtasks[]

  @@unique([learningPathId, stageNumber])
  @@index([learningPathId])
  @@index([status])
}


model subtasks {
  id                   String             @id
  milestoneId          String
  userId               String
  title                String
  description          String?
  taskType             String             @default("practice")
  estimatedMinutes     Int                @default(30)
  acceptanceCriteria   String?
  order                Int                @default(0)
  status               String             @default("todo")
  completedAt          DateTime?
  rating               Int?
  feedback             String?
  cognitiveLoad        String             @default("medium")
  createdAt            DateTime           @default(now())
  updatedAt            DateTime
  usersId              String?
  annotationConfidence Float?
  cognitiveLevel       String?
  icapLevel            String?
  coreConcept          String?
  displayLabel         String?
  knowledgeType        String?
  learningObjectives   String?
  transferable         Boolean?           @default(false)
  linkedConceptId      String?
  linkedConceptName    String?
  users                users?             @relation(fields: [usersId], references: [id])
  milestones           milestones         @relation(fields: [milestoneId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([userId])
  @@index([milestoneId])
  @@index([knowledgeType])
  @@index([cognitiveLevel])
  @@index([icapLevel])
  @@index([status, completedAt])
}


model teaching_sessions {
  id                      String    @id
  userId                  String
  taskId                  String
  learningPathId          String?
  milestoneId             String?
  subject                 String
  topic                   String
  taskType                String    @default("practice")
  mode                    String    @default("tutor")
  status                  String    @default("active")
  messages                String?
  knowledgeState          String?
  teachingState           String?
  wrapup                  String?
  advisory                String?
  startTime               DateTime  @default(now())
  endTime                 DateTime?
  duration                Int?
  revision                Int       @default(0)
  openKey                 String?   @unique
  operationId             String?
  operationKind           String?
  operationLeaseExpiresAt DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @default(now())
  users                   users     @relation(fields: [userId], references: [id], onDelete: Cascade)
  finalizationOperations  session_finalization_operations[]

  @@index([userId, taskId, status])
  @@index([status, updatedAt])
  @@index([operationLeaseExpiresAt])
  @@index([status])
  @@index([taskId])
  @@index([userId])
  @@index([userId, createdAt])
  @@index([startTime])
  @@index([learningPathId])
}

model session_finalization_operations {
  id              String   @id @default(uuid())
  sessionId       String
  idempotencyKey  String
  action          String
  requestHash     String
  requestJson     String
  status          String   @default("processing")
  leaseOwner      String?
  leaseExpiresAt  DateTime?
  attemptCount    Int      @default(1)
  resultJson      String?
  errorCode       String?
  retryable       Boolean?
  startedAt       DateTime @default(now())
  completedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  session         teaching_sessions @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, idempotencyKey])
  @@index([status, leaseExpiresAt])
  @@index([sessionId, action, createdAt])
}

model domain_event_outbox {
  id               String   @id
  eventType        String
  schemaVersion    Int      @default(1)
  aggregateType    String
  aggregateId      String
  aggregateVersion Int?
  userId           String?
  source           String
  payload          String
  metadata         String?
  status           String   @default("pending")
  attemptCount     Int      @default(0)
  availableAt      DateTime @default(now())
  lockedAt         DateTime?
  lockOwner        String?
  processedAt      DateTime?
  lastError        String?
  occurredAt       DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([status, availableAt])
  @@index([status, lockedAt])
  @@index([aggregateType, aggregateId, occurredAt])
  @@index([userId, occurredAt])
}

model domain_event_inbox {
  id         String   @id
  consumerId String
  eventId    String
  processedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@unique([consumerId, eventId])
  @@index([eventId])
}

model learner_evidence {
  id           String   @id
  eventId      String
  evidenceKey  String
  userId       String
  pathId       String?
  milestoneId  String?
  taskId       String?
  sessionId    String?
  evidenceType String
  payload      String
  confidence   Float    @default(1)
  occurredAt   DateTime
  createdAt    DateTime @default(now())

  @@unique([eventId, evidenceKey])
  @@index([userId, occurredAt])
  @@index([pathId, occurredAt])
  @@index([sessionId])
  @@index([taskId])
}

// 误解台账（G-R-R Phase 2）：跨会话追踪结构化误解的生命周期
// suspected（首次观察到）→ confirmed（再次出现，假设得到佐证）→ addressed（学生后续正确表现，误解已消除）
model misconception_ledger {
  id              String   @id
  userId          String
  conceptKey      String
  hypothesisHash  String   // hypothesis 文本短哈希（跨会话去重/upsert 锚点）
  hypothesis      String
  canonicalLabel  String?
  confidence      Int      // 0|25|50|75|100 软分级置信度（G-R-R 约定）
  evidence        String?
  status          String   @default("suspected") // suspected | confirmed | addressed
  occurrenceCount Int      @default(1)
  firstSeenAt     DateTime @default(now())
  lastSeenAt      DateTime @default(now())
  lastSessionId   String?
  resolvedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, conceptKey, hypothesisHash])
  @@index([userId, status])
  @@index([userId, lastSeenAt])
}

model learner_projections {
  id             String   @id
  projectionKey  String   @unique
  userId         String
  scope          String
  pathId         String?
  milestoneId    String?
  taskId         String?
  version        Int      @default(1)
  payload        String
  lastEventId    String?
  lastEventAt    DateTime?
  generatedAt    DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId, scope])
  @@index([userId, pathId, scope])
  @@index([lastEventAt])
}

/// 学习表现预测校准记录（learning-predictor 校准闭环）：
/// 每次任务前预测一行，任务完成后回写实际结果，据此统计「实证命中率」替代 LLM 自报置信度。
model prediction_records {
  id            String   @id
  userId        String
  pathId        String?
  taskId        String?
  milestoneId   String?
  sessionId     String?
  stallRisk     Float
  predictedTone String // smooth | struggle | fatigue
  suggestedDepth String // shallow | standard | deep
  focusConcepts String // JSON string[]
  rationale     String
  // 实证对照（任务完成后回写）
  outcome       String? // not_evaluated | smooth | struggled | failed
  outcomeAt     DateTime?
  // 预测来源快照（摘要片段），便于追溯
  summaryEcho   String?
  createdAt     DateTime @default(now())

  @@index([userId, taskId])
  @@index([userId, createdAt])
  @@index([outcome])
}

/// 知识点记忆痕迹（记忆引擎 M2）：ACT-R 幂律衰减的持久化载体。
/// 每个（用户 × 概念）一行；masteryScore 为最近一次评估的内化强度，
/// lastSeenAt 为最近一次提取/复习时间，decayFactor 为幂律衰减参数 d（默认 0.5，预留个性化标定）。
model memory_traces {
  id              String    @id
  userId          String
  conceptKey      String
  label           String?
  masteryScore    Float     @default(0.5)
  stability       String    @default("developing") // unknown | fragile | developing | stable
  lastSeenAt      DateTime?
  extractionCount Int       @default(0)
  decayFactor     Float     @default(0.5)
  // SM-2 式间隔递增因子：复习成功 ×2（上限在计算侧 clamp 32），初始 1
  intervalFactor  Float     @default(1)
  source          String?   // derived（从 knowledgeState 确定性映射）| model（LLM 评估，预留）| review-event
  dueAt           DateTime? // 下次到期时间（FSRS/调度物化列；null 走旧惰性 isReviewDue 兜底）
  fsrsStability   Float?    // FSRS-6 稳定性（天）：回忆率降到 desiredRetention 所需时间；null = 未初始化（走 legacy ACT-R 兜底）
  fsrsDifficulty  Float?    // FSRS-6 难度（1-10）：null = 未初始化
  ktMasteryEma    Float?    // θ−d 知识状态 EMA（LLM ktEstimate 的跨会话滑动平均，α=0.2；null = 未初始化）
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([userId, conceptKey])
  @@index([userId, lastSeenAt])
  @@index([userId, stability])
  @@index([userId, dueAt])
}

model user_agent_configs {
  id               String   @id
  userId           String
  agentName        String
  enabled          Boolean  @default(true)
  sourceType       String
  codeRepositoryId String?
  model            String?
  temperature      Float?
  maxTokens        Int?
  systemPrompt     String?
  customCode       String?
  version          String   @default("1.0.0")
  stats            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime
  users            users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, agentName])
}

model user_agent_model_configs {
  id          String   @id
  userId      String
  agentId     String
  model       String?
  endpoint    String?
  apiKey      String?
  temperature Float?
  maxTokens   Int?
  enabled     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime
  users       users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, agentId])
}

model user_api_configs {
  id             String   @id
  userId         String   @unique
  endpoint       String?
  apiKey         String?
  chatModel      String?
  reasoningModel String?
  enabled        Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now())
  users          users    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model user_mcp_configs {
  id              String   @id
  userId          String   @unique
  servers         String
  tools           String
  routingStrategy String   @default("priority")
  fallbackEnabled Boolean  @default(true)
  healthCheck     String
  createdAt       DateTime @default(now())
  updatedAt       DateTime
  users           users    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model user_skill_configs {
  id               String   @id
  userId           String
  skillName        String
  enabled          Boolean  @default(true)
  sourceType       String
  codeRepositoryId String?
  parameters       String?
  customCode       String?
  endpoint         String?
  stats            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime
  users            users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, skillName])
}

model projection_access_grants {
  id                String   @id @default(uuid())
  userId            String
  scope             String   @default("dashboard")
  scopeDefinition   String?
  purpose           String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  expiresAt         DateTime
  revokedAt         DateTime?
  lastUsedAt        DateTime?
  lastUsedByAdminId String?
  useCount          Int      @default(0)
  users             users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
}

model users {
  id                        String                     @id
  email                     String                     @unique
  name                      String
  password                  String
  // 数据层审计 S4：role 枚举（'user' | 'admin'）由应用层强制（isAdmin 为实际鉴权依据），
  // 未加 CHECK 约束——SQLite 需重建整表（users 被 ~20 张子表外键引用，重建风险大于收益）。
  role                      String                     @default("user")
  currentLevel              String                     @default("beginner")
  xp                        Int                        @default(0)
  isAdmin                   Boolean                    @default(false)
  isVirtualLearner          Boolean                    @default(false)
  // 软删除（Phase 1）：deletedAt 非空即视为已删除，deletedBy 记录操作管理员；历史数据保留
  deletedAt                 DateTime?
  deletedBy                 String?
  // 令牌吊销版本：改密/管理员重置密码时递增，旧 JWT 立即失效
  tokenVersion              Int                        @default(0)
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime
  lastLoginAt               DateTime?
  streakDays                Int                        @default(0)
  streakLastDate            DateTime?
  longestStreak             Int                        @default(0)
  onboardingCompleted       Boolean                    @default(false)
  dashboardGuidanceSnapshot String?
  learningStateRevision     Int                        @default(0)
  achievements              achievements[]
  content_feedback          content_feedback[]
  goal_conversations        goal_conversations[]
  learning_goals            learning_goals[]
  learning_metrics          learning_metrics[]
  learning_paths            learning_paths[]
  projection_access_grants  projection_access_grants[]
  subtasks                  subtasks[]
  teaching_sessions         teaching_sessions[]
  user_agent_configs        user_agent_configs[]
  user_agent_model_configs  user_agent_model_configs[]
  user_api_configs          user_api_configs?
  user_mcp_configs          user_mcp_configs?
  user_skill_configs        user_skill_configs[]
  virtual_learner_profiles  virtual_learner_profiles?
  virtual_sessions          virtual_sessions[]
  password_reset_tokens     password_reset_tokens[]
  notifications             notifications[]

  @@index([deletedAt])
}

// 忘记密码自助重置令牌：tokenHash 存哈希，一次性使用，带过期时间
model password_reset_tokens {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  users     users     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
}

model virtual_learner_profiles {
  id                    String             @id @default(uuid())
  userId                String             @unique
  profile               String
  learningGoal          String
  knowledgeLevel        String
  knownConcepts         String?
  struggleConcepts      String?
  simulationMode        String             @default("manual")
  simulationPrompt      String?
  simulationModel       String?
  simulationTemperature Float?             @default(0.8)
  personalityTraits     String?
  tags                  String?
  notes                 String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  users                 users              @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions              virtual_sessions[]

  @@index([userId])
}

model virtual_sessions {
  id                       String                   @id @default(uuid())
  virtualProfileId         String
  userId                   String
  status                   String                   @default("created")
  currentStage             String                   @default("goal")
  goalConversationId       String?
  learningPathId           String?
  currentTaskId            String?
  completedTasks           Int                      @default(0)
  totalTasks               Int                      @default(0)
  stageResults             String?
  logs                     String?
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt
  completedAt              DateTime?
  users                    users                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  virtual_learner_profiles virtual_learner_profiles @relation(fields: [virtualProfileId], references: [id], onDelete: Cascade)
  experimentLease          virtual_experiment_leases?
  experimentCommands       virtual_experiment_commands[]

  @@index([virtualProfileId])
  @@index([userId])
  @@index([status])
}

model virtual_experiment_leases {
  sessionId String   @id
  ownerId   String
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  session   virtual_sessions @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model virtual_experiment_commands {
  id          String   @id @default(uuid())
  sessionId   String
  experimentId String
  runId       String
  commandId   String
  sequence    Int
  kind        String
  requestJson String
  status      String   @default("processing")
  resultJson  String?
  errorJson   String?
  triggeredBy String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  completedAt DateTime?
  session     virtual_sessions @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([runId, commandId])
  @@unique([runId, sequence])
  @@index([sessionId, createdAt])
  @@index([runId, status])
}

model virtual_quick_learn_runs {
  id                String    @id @default(uuid())
  profileId         String
  userId            String
  pathId            String
  taskId            String
  fixtureOfPathId   String?
  mode              String    @default("fast_forward")
  status            String    @default("queued")
  maxTurns          Int       @default(25)
  turns             Int       @default(0)
  teachingSessionId String?
  // 单课上下文：所属故事（JSON，含 visibleOpening/goalSeed/pressurePoints 等），null 表示无故事（V1 兼容）
  story             String?
  // 行为摩擦预算档位：none|low|normal|high|stress_test（V1 默认 none 保持兼容）
  frictionBudget    String    @default("none")
  progress          String?
  transcript        String?
  report            String?
  error             String?
  abortRequestedAt  DateTime?
  startedAt         DateTime?
  completedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([profileId, createdAt])
  @@index([status])
  @@index([userId])
}

model announcements {
  id          String    @id @default(uuid())
  title       String
  body        String
  severity    String    @default("info")
  status      String    @default("draft")
  publishedAt DateTime?
  expiresAt   DateTime?
  createdBy   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // 数据层审计 S4：status/severity 枚举约束由迁移 SQL 的 CHECK 约束强制
  // （SQLite ALTER TABLE 不支持 ADD CONSTRAINT，已在迁移中重建表添加）：
  //   status   IN ('draft','published','archived')
  //   severity IN ('info','warning','critical')
  @@index([status, publishedAt])
  @@index([status, expiresAt])
}

// 站内通知（admin 后台定向/全员推送，P2）
// 用户端通过 GET /api/notifications 拉取；已读状态由通知行 isRead 标记。
model notifications {
  id          String    @id @default(uuid())
  userId      String
  title       String
  body        String?
  kind        String    @default("system") // system | announcement | achievement
  link        String?
  isRead      Boolean   @default(false)
  readAt      DateTime?
  createdBy   String?
  createdAt   DateTime  @default(now())
  users       users     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@index([kind])
}

// 操作审计日志（admin 后台敏感操作，P1）
// 由 admin-audit.middleware 在响应 finish 时 fire-and-forget 写入；
// before/after/request 快照均为 redactLogValue 脱敏后的 JSON 字符串。
model admin_audit_logs {
  id          String   @id @default(uuid())
  adminId     String?
  adminName   String?
  action      String
  targetType  String?
  targetId    String?
  beforeJson  String?
  afterJson   String?
  requestJson String?
  method      String
  path        String
  statusCode  Int
  success     Boolean
  ip          String?
  userAgent   String?
  durationMs  Int?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([adminId, createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId, createdAt])
}

// 管理员会话表（P2 方案 B：轻量完整会话表）
// 由 admin-auth 签发/登出时写入，admin.middleware 鉴权时校验（revokedAt/expiresAt），
// lastSeenAt 由内存节流（60s）fire-and-forget 更新。
// 与 admin_audit_logs 同约定：adminId 为纯列（无外键），避免 SQLite 重建表风险。
model admin_sessions {
  id         String    @id
  adminId    String
  jti        String    @unique
  ip         String?
  userAgent  String?
  remember   Boolean   @default(false)
  issuedAt   DateTime
  expiresAt  DateTime
  lastSeenAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([adminId, createdAt])
  @@index([revokedAt, expiresAt])
}

// 登录审计（user/admin 双 scope，P1）
// 由 login-rate-limit.middleware 的 recordLoginAttempt / ACCOUNT_LOCKED 分支
// fire-and-forget 写入；username 在写入前截断为 64 字符。
model login_attempts {
  id        String   @id @default(uuid())
  scope     String
  username  String
  ip        String?
  success   Boolean
  reason    String?
  userId    String?
  createdAt DateTime @default(now())

  @@index([scope, createdAt])
  @@index([username, createdAt])
  @@index([ip, createdAt])
  @@index([success, createdAt])
}

// 批量实验（admin 虚拟学习者页 · 系统级队列实验）
// 由 batch-experiment.service 驱动：创建学习者 → goal → path → 学完任务 → 跨日衰减模拟，
// 每任务快照 memory_traces/learner_evidence 供画像系统验证。
model batch_experiments {
  id             String    @id @default(uuid())
  name           String
  description    String?
  status         String    @default("running") // running | paused | stopped | done
  createdBy      String
  learnersConfig String // JSON: [{name, learningGoal, frictionBudget}]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  runs           batch_experiment_runs[]

  @@index([status, createdAt])
}

model batch_experiment_runs {
  id              String   @id @default(uuid())
  experimentId    String
  profileId       String?
  sessionId       String?
  learnerName     String
  frictionBudget  String   @default("normal")
  phase           String   @default("setup") // setup|goal|path|learn|learn-done|decay|done|failed
  status          String   @default("active") // active|stalled|done|failed
  completedTasks  Int      @default(0)
  totalTasks      Int?
  currentTask     String?
  stallCount      Int      @default(0)
  lastError       String?
  advanceCalled   Boolean  @default(false)
  learningStarted Boolean  @default(false)
  checkpoints     String? // JSON: [{at, task, milestone, totalMilestones, traceCount, mastered, evidence}]
  decaySims       String? // JSON: [{days, at, traceCount, retained, snapshot}]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  experiment      batch_experiments @relation(fields: [experimentId], references: [id], onDelete: Cascade)

  @@index([experimentId])
  @@index([status])
}

// 批量新建虚拟学习者后台任务（服务端队列：创建人 + 后台逐个生成身份/故事；
// 前端只提交并轮询进度，刷新/切页不影响任务执行）
model virtual_batch_jobs {
  id           String   @id @default(uuid())
  kind         String   @default("create-learners")
  status       String   @default("running") // running / done / error
  total        Int      @default(0) // 总人数
  created      Int      @default(0) // 已创建人数
  totalStories Int      @default(0) // 总故事数
  storiesDone  Int      @default(0) // 已完成故事数
  personaLeft  Int      @default(0) // 剩余待生成身份人数
  queue        String? // JSON: [{ profileId, name, storyCount, needsPersona }]
  failed       String? // JSON: 失败项数组
  error        String?
  cohort       String? // 人群描述（可选）
  note         String? // 批次备注（可选）
  createdBy    String?
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}
