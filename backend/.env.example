# ===========================================
# WenFlow 后端配置 - 开发环境默认
# ===========================================

# 服务器配置
NODE_ENV=development
PORT=3001

# CORS 配置 (多个来源用逗号分隔)
# 【部署时修改】改成你的实际访问地址，如:
# CORS_ORIGIN=http://192.168.1.100:5173,https://yourdomain.com
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# 反向代理配置（Nginx/Cloudflare 等）
# 开发环境默认不信任代理；生产环境建议设为 1
# TRUST_PROXY=1

# ===========================================
# 数据库配置
# ===========================================
# 【开发环境】SQLite (简单，无需安装)
DATABASE_URL=file:./dev.db
# 【生产环境】如需 PostgreSQL，改为:
# DATABASE_URL="postgresql://user:password@localhost:5432/wenflow_db"

# ===========================================
# 安全配置（必须配置，生产环境强制要求）
# ===========================================

# JWT 密钥（必须32位以上随机字符串）
# 生成命令：openssl rand -base64 32 或 node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=

# ===========================================
# Admin 访问限制
# ===========================================
# 管理员登录仅允许本地访问（已启用）
ADMIN_LOCALHOST_ONLY=true

# ===========================================
# 登录保护配置
# ===========================================
# 最大登录失败次数
LOGIN_MAX_ATTEMPTS=5
# 锁定时间（秒），默认15分钟
LOGIN_LOCK_DURATION=900

# JWT 配置
JWT_EXPIRES_IN=7d

# AI 服务配置
AI_API_URL=https://api.deepseek.com
AI_API_KEY=sk-your-api-key
AI_MODEL=deepseek-chat
AI_MODEL_REASONING=deepseek-reasoner

# 前端 URL
FRONTEND_URL=http://localhost:5173

# ===========================================
# 初始管理员配置
# ===========================================
# 警告：生产环境必须使用强密码！
# 密码要求：至少8位，包含字母和数字
INIT_ADMIN_NAME=admin
INIT_ADMIN_PASSWORD=  # 请设置强密码
