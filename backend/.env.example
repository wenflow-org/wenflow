# ===========================================
# WenFlow 后端配置 - 开发环境默认
# ===========================================

# 服务器配置
NODE_ENV=development
PORT=3001

# CORS 配置 (多个来源用逗号分隔)
# 【部署时修改】改成你的实际访问地址，如:
# CORS_ORIGIN=http://192.168.1.100:5173,https://yourdomain.com
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# 反向代理配置（Nginx/Cloudflare 等）
# 开发环境默认不信任代理；生产环境建议设为 1
# 重要：如果管理员远程登录限制不生效，请设为 1
TRUST_PROXY=0

# ===========================================
# 数据库配置
# ===========================================
# 【开发环境】SQLite (简单，无需安装)
# 使用 prisma 子目录，避免工作目录变化导致数据库位置不一致
DATABASE_URL=file:./prisma/dev.db
# 系统配置独立数据库（prompt、模型配置等）
SYSTEM_DATABASE_URL=file:./prisma/system.db
# 【生产环境】如需 PostgreSQL，改为:
# DATABASE_URL="postgresql://user:password@localhost:5432/wenflow_db"

# ===========================================
# 安全配置（必须配置，生产环境强制要求）
# ===========================================

# JWT 密钥（必须32位以上随机字符串）
# 生成命令：openssl rand -base64 32 或 node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=

# ===========================================
# Admin 访问限制
# ===========================================
# 管理员登录仅允许本地访问（默认：true）
# 设为 false 可允许远程登录（不推荐，有安全风险）
ADMIN_LOCALHOST_ONLY=true

# ===========================================
# 登录保护配置
# ===========================================
# 最大登录失败次数
LOGIN_MAX_ATTEMPTS=5
# 锁定时间（秒），默认15分钟
LOGIN_LOCK_DURATION=900

# JWT 配置
JWT_EXPIRES_IN=7d

# AI 服务配置
AI_API_URL=https://api.deepseek.com
AI_API_KEY=sk-your-api-key
AI_MODEL=deepseek-v4-flash
AI_MODEL_REASONING=deepseek-v4-pro

# 前端 URL
FRONTEND_URL=http://localhost:5173

# ===========================================
# 初始管理员配置
# ===========================================
# 首次启动时自动创建管理员账户
# 如果留空，将使用默认值 admin / admin123
INIT_ADMIN_NAME=admin
INIT_ADMIN_EMAIL=admin@wenflow.local
INIT_ADMIN_PASSWORD=admin123
