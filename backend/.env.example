# ===========================================
# WenFlow 后端配置 - 开发环境默认
# ===========================================

# 服务器配置
NODE_ENV=development
PORT=3001
# 后端日志目录。相对路径按 backend/ 解析；容器建议使用 /app/data/logs。
LOG_DIR=logs

# ===========================================
# 日志保留清理（agent_call_logs / llm_execution_attempts / prompt_call_logs）
# ===========================================
# 保留天数（默认 90；cutoff = now - 保留期 - 1h 时钟偏差缓冲）
LOG_RETENTION_DAYS=90
# 清理周期（小时，默认 6）
LOG_RETENTION_INTERVAL_HOURS=6
# 1=只统计不删除（dry-run），默认 0 正常清理
LOG_RETENTION_DRY_RUN=0
# 虚拟会话轨迹（virtual_sessions.logs）字节预算：写入期按此保留最新日志（默认 2 MB）
SIMULATION_LOG_MAX_BYTES=2097152
# 过期虚拟会话在保留清理时把 logs 裁到的更小预算（默认 256 KB；<=0 关闭该步骤）
VIRTUAL_SESSION_LOG_RETENTION_MAX_BYTES=262144
# 虚拟会话 logs 的冷却窗（小时，默认 24）：超过该时长未更新的会话，logs 会被裁到上面的预算。
# 注意日志保留窗（90 天）对会话轨迹太慢——轨迹冷得快，等 90 天等于不回收。
VIRTUAL_SESSION_LOG_TRIM_AFTER_HOURS=24

# Virtual Learner Lab 通过普通用户 API 驱动平台时使用，必须包含 /api。
PLATFORM_API_BASE_URL=http://127.0.0.1:3001/api

# CORS 配置 (多个来源用逗号分隔)
# 【部署时修改】改成你的实际访问地址，如:
# CORS_ORIGIN=http://192.168.1.100:5173,https://yourdomain.com
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# 反向代理配置（Nginx/Cloudflare 等）
# 开发环境默认不信任代理；部署时填写直接连接后端的代理 IP/CIDR。
# 仅在拓扑固定且后端不能被绕过代理直连时，才使用跳数配置。
TRUST_PROXY=0
# 收到 SIGTERM 后用于 HTTP drain 和后台组件停止的总时限。
SHUTDOWN_DEADLINE_MS=25000

# ===========================================
# 数据库配置
# ===========================================
# 【开发环境】SQLite (简单，无需安装)
# 使用 prisma 子目录，避免工作目录变化导致数据库位置不一致
DATABASE_URL=file:./dev.db
# 系统配置独立数据库（prompt、模型配置等）
SYSTEM_DATABASE_URL=file:../system.db
# 正式备份必须位于 Git 工作区之外，并使用绝对路径。
WENFLOW_BACKUP_DIR=
# 【生产环境】如需 PostgreSQL，改为:
# DATABASE_URL="postgresql://user:password@localhost:5432/wenflow_db"

# ===========================================
# 安全配置（必须配置，生产环境强制要求）
# ===========================================

# JWT 密钥（必须32位以上随机字符串）
# 生成命令：openssl rand -base64 32 或 node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=

# 数据库 Secret 静态加密。每项格式为 keyId:32字节Base64，多把密钥用逗号分隔。
# 生成密钥：node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SECRET_ENCRYPTION_CURRENT_KEY_ID=v1
SECRET_ENCRYPTION_KEYS=v1:

# ===========================================
# Admin 访问限制
# ===========================================
# Admin 网络范围：loopback=仅本机，private=本机+局域网（默认），any=不限制来源
ADMIN_ACCESS_MODE=private
# 可额外放行的精确客户端 IP，逗号分隔
ADMIN_ALLOWED_IPS=

# ===========================================
# 登录保护配置
# ===========================================
# 最大登录失败次数
LOGIN_MAX_ATTEMPTS=5
# 锁定时间（秒），默认15分钟
LOGIN_LOCK_DURATION_SECONDS=900

# JWT 配置
JWT_EXPIRES_IN=7d

# AI 服务配置
AI_API_URL=https://api.deepseek.com
AI_API_KEY=sk-your-api-key
AI_MODEL=deepseek-v4-flash
AI_MODEL_REASONING=deepseek-v4-pro
# 生产环境如需访问私有模型服务，精确填写 Host 或 IP，逗号分隔；不要开放整个私网段
SAFE_HTTP_PRIVATE_HOSTS=
# 是否允许访问任意本机/RFC1918 局域网服务。开发环境默认 true，生产默认 false。
# 保存 Admin「连接与安全」页面后，以 System DB 中的平台策略为准。
SAFE_HTTP_ALLOW_PRIVATE_NETWORK=true
# 如基础设施使用 RFC 6052 自定义 NAT64 前缀，必须在此登记 CIDR，逗号分隔。
# 支持 /32、/40、/48、/56、/64、/96，例如 2001:db8:64::/48。
SAFE_HTTP_NAT64_PREFIXES=
# 显式信任的域名白名单（逗号分隔，精确匹配，不支持通配）：命中时跳过“解析地址段”的 SSRF 拒绝。
# 仅用于 fake-IP / TUN 代理的开发环境（会把公网域名解析到 198.18.0.0/15 等保留段）；
# 生产环境 DNS 正常时保持为空。
SAFE_HTTP_TRUSTED_HOSTS=

# 前端 URL
FRONTEND_URL=http://localhost:5173

# ===========================================
# 初始管理员配置
# ===========================================
# 首次启动时可自动创建管理员账户。开发环境不配置时使用内置默认密码
# ChangeMe_2026_Admin（首次登录后请立即修改）；生产环境必须显式设置，
# 留空则跳过创建。至少 12 位，并包含大小写字母和数字。不要提交真实密码。
INIT_ADMIN_NAME=admin
INIT_ADMIN_EMAIL=admin@wenflow.local
INIT_ADMIN_PASSWORD=

# ===========================================
# 网页搜索（外挂能力 web-search；TinyFish Search 免费，$0）
# ===========================================
# provider 降级链，逗号分隔（已实现：tinyfish；预留：tavily / exa）
SEARCH_PROVIDER=tinyfish
# TinyFish Search：GET + X-API-Key，密钥在 https://agent.tinyfish.ai/api-keys 创建
SEARCH_API_URL=https://api.search.tinyfish.ai
SEARCH_API_KEY=replace-with-your-tinyfish-search-key
SEARCH_TIMEOUT_MS=20000
# 可选降级 provider（留空即不启用；配置后可用 SEARCH_PROVIDER=tinyfish,tavily,exa 组降级链）
# Tavily 官方端点：https://api.tavily.com/search（密钥 tvly-...）
# 也可指向 Tavily 兼容代理，例如公益代理 base 为 https://tavily.fuhuagoogle.top/api/tavily
TAVILY_API_URL=https://api.tavily.com/search
TAVILY_API_KEY=
# Exa 官方端点：https://api.exa.ai/search（密钥在 dashboard.exa.ai 创建）
EXA_API_URL=https://api.exa.ai/search
EXA_API_KEY=

# ===========================================
# 网页抓取（外挂能力 web-fetch；TinyFish Fetch 免费，$0）
# 与 web-search 并列：search 负责找出 URL，fetch 负责取回正文
# ===========================================
# provider 降级链，逗号分隔（已实现：tinyfish / tavily / exa）
# 缺省与 SEARCH_PROVIDER 独立配置，便于"搜索强、抓取弱"的 provider 分开排链
FETCH_PROVIDER=tinyfish
# TinyFish Fetch：POST + X-API-Key（端点与 search 不同，密钥同一把）
FETCH_API_URL=https://api.fetch.tinyfish.ai
# 缺省复用 SEARCH_API_KEY，仅在需要单独用另一把 key 时才填
FETCH_API_KEY=
FETCH_TIMEOUT_MS=60000
# 可选降级 provider（留空即不启用）
# Tavily Extract：https://api.tavily.com/extract（也可指向兼容代理，如 https://.../api/tavily/extract）
TAVILY_EXTRACT_URL=https://api.tavily.com/extract
# Exa Contents：https://api.exa.ai/contents
EXA_CONTENTS_URL=https://api.exa.ai/contents

# ===========================================
# 文生图（外挂能力 text-to-image；OpenAI 兼容 /v1/images/generations）
# ===========================================
# provider 降级链，逗号分隔（已实现：agnes）
IMAGE_PROVIDER=agnes
# OpenAI 兼容生图端点（完整地址），例如 new-api 网关：http://<host>:<port>/v1/images/generations
IMAGE_API_URL=
IMAGE_API_KEY=
# 默认模型（可被调用方 model 字段覆盖）；new-api 网关实测可用：agnes-image-2.5-flash
IMAGE_MODEL=agnes-image-2.5-flash
# 生图比搜索/抓取慢，默认 180s
IMAGE_TIMEOUT_MS=180000
