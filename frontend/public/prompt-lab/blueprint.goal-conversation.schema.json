{
  "input": [
    {
      "field": "userInput",
      "type": "string",
      "description": "当前轮用户输入",
      "required": true
    },
    {
      "field": "state",
      "type": "object",
      "description": "主记忆对象，优先级最高",
      "required": true,
      "properties": [
        {
          "field": "stage",
          "type": "enum",
          "values": ["understanding", "proposing", "ready"],
          "description": "当前所处阶段",
          "required": true
        },
        {
          "field": "confidence",
          "type": "number",
          "description": "信息完整度置信度，范围 0-0.99",
          "required": true
        },
        {
          "field": "done",
          "type": "boolean",
          "description": "是否完成目标澄清",
          "required": true
        }
      ]
    },
    {
      "field": "conversationContext",
      "type": "object",
      "description": "过往对话的摘要化上下文证据",
      "required": false
    }
  ],
  "output": [
    {
      "field": "reply",
      "type": "string",
      "description": "给用户的回复",
      "required": true
    },
    {
      "field": "state",
      "type": "object",
      "description": "更新后的状态",
      "required": true
    },
    {
      "field": "understanding",
      "type": "object",
      "description": "对学习者目标的理解结构",
      "required": true
    },
    {
      "field": "nextQuestions",
      "type": "array",
      "description": "候选的下一个问题",
      "required": false
    },
    {
      "field": "quickReplies",
      "type": "array",
      "description": "快捷回复选项",
      "required": false
    },
    {
      "field": "confirmedProposal",
      "type": "object",
      "description": "确认的学习方向提案",
      "required": false
    },
    {
      "field": "confidenceScores",
      "type": "object",
      "description": "各维度的信息完整度评分",
      "required": true
    }
  ]
}
