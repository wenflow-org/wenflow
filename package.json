{
  "name": "wenflow",
  "version": "1.0.0",
  "description": "问流 / WenFlow - A learning system for navigating uncertainty",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "powershell -ExecutionPolicy Bypass -File ./start-dev.ps1",
    "dev:nginx": "powershell -ExecutionPolicy Bypass -File ./start-dev.ps1 -UseNginx",
    "dev:lan": "powershell -ExecutionPolicy Bypass -File ./start-lan.ps1",
    "env:setup": "powershell -ExecutionPolicy Bypass -File ./setup-env.ps1",
    "env:edit": "powershell -ExecutionPolicy Bypass -File ./setup-env.ps1 -EditOnly",
    "secrets:audit": "npm --prefix backend run secrets:audit",
    "secrets:migrate": "npm --prefix backend run secrets:migrate",
    "prisma:migrate:verify-clean": "npm --prefix backend run prisma:migrate:verify-clean",
    "prisma:baseline:audit": "npm --prefix backend run prisma:baseline:audit",
    "prisma:baseline:adopt": "npm --prefix backend run prisma:baseline:adopt",
    "security:scan:current": "node scripts/secret-scan.mjs --current",
    "security:scan:history": "node scripts/secret-scan.mjs --history",
    "security:scan": "npm run security:scan:current && npm run security:scan:history",
    "permissions:audit": "npm --prefix backend run permissions:audit",
    "permissions:repair": "npm --prefix backend run permissions:repair",
    "database:backup:create": "npm run build:backend && npm --prefix backend run database:backup:create --",
    "database:backup:verify": "npm run build:backend && npm --prefix backend run database:backup:verify --",
    "test": "npm --prefix backend run test:ci",
    "typecheck:backend": "npm --prefix backend run typecheck",
    "build:backend": "npm --prefix backend run build",
    "build:frontend": "npm --prefix frontend run build",
    "prisma:validate": "npm --prefix backend run prisma:validate",
    "check": "npm run security:scan:current && npm run prisma:validate && npm run prisma:migrate:verify-clean && npm run typecheck:backend && npm test && npm run build:backend && npm run build:frontend",
    "check:frontend-types": "npm --prefix frontend run typecheck",
    "lint": "npm --prefix backend run lint && npm --prefix frontend run lint"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=20.17.0"
  },
  "dependencies": {
    "axios": "^1.13.6",
    "oh-my-opencode-windows-x64": "^3.12.3",
    "playwright": "^1.58.2"
  }
}
